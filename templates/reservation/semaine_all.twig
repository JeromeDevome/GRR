{% extends 'layout.twig' %}

{% import 'messagesysteme.twig' as msgSyst %}
{% import 'champs.twig' as form %}
{% import 'planning.twig' as planning %}

{% block css %}
{{d.cssTypeResa |raw}}
{% endblock %}

{% block content %}

<section>

<!-- ! MenuHG  -->
	{% if d.pview != 1 %}
		{{ planning.menuGauche(settings, d.selecteursG, d.miniCalentrier, d.selectionDateDirecte, d.legende, d.area, d.room) }}
		{{ planning.menuHaut(settings, d.selecteursH, d.miniCalentrier, d.selectionDateDirecte, d.legende, d.area, d.room) }}

		<div id='planning2'>
	{% else %}
		<div id="print_planning">
	{% endif %}

	<table class="semaine table-bordered table-striped">
		<caption>

			{% if d.pview != 1 %} <!-- liens semaine avant-après et imprimante si page non imprimable -->
        <div class="ligne23">
					<div class="left">
						<button class="btn btn-default btn-xs" onclick="javascript: location.href='semaine_all?year={{d.yy}}&amp;month={{d.ym}}&amp;day={{d.yd}}&amp;area={{d.area}}';" ><i class="fa-solid fa-angles-left"></i> {{'weekbefore'|trans}}</button>
					</div>

					{{ planning.imprimante(settings, d.paramUrl) }}

					<div class="right">
						<button class="btn btn-default btn-xs" onclick="javascript: location.href='semaine_all?year={{d.ty}}&amp;month={{d.tm}}&amp;day={{d.td}}&amp;area={{d.area}}';">{{'weekafter'|trans}} <i class="fa-solid fa-angles-right"></i></button>
					</div>
        </div>

			{% endif %}

			<div>
				{% if d.pview != 1 %} <!-- afficher ou cacher le menu si page non imprimable -->
					<div class="left">
						<div id="voir"><button class="btn btn-default btn-sm" onClick="afficheMenuHG({{d.positionMenu}})" title="{{'show_left_menu'|trans}}"><i class="fas fa-bars"></i></button></div>
						<div id="cacher"><button class="btn btn-default btn-sm" onClick="afficheMenuHG(0)" title="{{'hide_left_menu'|trans}}"><i class="fas fa-bars"></i></button></div> 
					</div>
				{% endif %}

				<h4 class="titre">
					{{d.nomDomaine}} - {{'all_areas'|trans}}<br>
					{{'week'|trans}}{{'deux_points'|trans}} {{d.semaineDebut}} - {{d.semaineFin}}
				</h4>

				{% if d.pview == 1 and d.precedent == 1 %}
					<span id="lienPrecedent">
						<button class="btn btn-default btn-xs" onclick="javascript:history.back();">Précedent</button>
					</span>
				{% endif %}
			</div>
		</caption>
		<thead>
			<tr>
                <th class="jour_sem">{{'rooms'|trans}}</th>
				{% for jour in joursSemaine %}
					<th class="jour_sem {{jour.class}}">
                        <a href="jour?year={{jour.annee}}&amp;month={{jour.mois}}&amp;day={{jour.numJour}}&amp;area={{d.area}}">
                            {{jour.nomJour}}
                            {% if jour.nomCycle != "" %}<br>{{jour.nomCycle}}{% endif %}
                        </a>
                    </th>
				{% endfor %}
			</tr>
		</thead>
		<tbody>
            {% for ressource in ressourcesSemaine %}
            <tr>
                <!-- 1ere colonne avec le nom des ressources -->
                <td class="{{ressource.class}}">
                    <a href="semaine?year={{d.gYear}}&amp;month={{d.gMonth}}&amp;day={{d.gDay}}&amp;area={{d.area}}&amp;room={{ressource.id}}" title="{{'see_week_for_this_room'|trans}}">
                        {{ressource.nom}}
                    </a>
                    <br>
                    {% if d.pview != 1 %}
                        {% if ressource.capacite %}
                            <span class="small">{{ressource.capacite}} {% if ressource.capacite > 1 %}{{'number_max2'|trans}}{% else %}{{'number_max'|trans}}{% endif %}</span><br>
                        {% endif %}

                        {% if ressource.fiche %}
                            <a href="javascript:centrerpopup('ressourcefiche?id_room={{ressource.id}},600,480,scrollbars=yes,statusbar=no,resizable=yes')" title="{{'fiche_ressource'|trans}}">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </a>
                        {% endif %}

                        {% if ressource.acces_config %}
                            <a href="./admin/admin.php?p=admin_edit_room&amp;room={{ressource.id}}"><i class="fa-solid fa-gear"></i></a>
                        {% endif %}

                    {% endif %}

                    {% if ressource.statut == 0 %}
                        <br><span class="texte_ress_tempo_indispo">{{'ressource_temporairement_indisponible'|trans}}</span>
                    {% endif %}
                </td>

                <!-- X colonnes suivantes avec les résa par jopurs -->
                {% for jourR in ressource.joursRessource %}
                    <td class="dragdrop {{jourR.class}}" data-day="{{jourR.jour}}" data-month="{{jourR.mois}}" data-year="{{jourR.annee}}" data-ressource="{{ressource.id}}">
                        {% for resa in jourR.reservations %}
                            <table class="resadrag pleine center" data-resa-id="{{resa.idresa}}" data-day="{{jourR.jour}}" data-month="{{jourR.mois}}" data-year="{{jourR.annee}}">
                                <tr>
                                    <td class="type{{resa.class}}">

                                            {% if resa.lienFiche %}
                                                {% if settings.display_level_view_entry == 0 %}
                                                    <a title="{{resa.bulle}}" style="border-bottom:1px solid #FFF" data-width="675" onclick="request({{resa.idresa}},{{jourR.jour}},{{jourR.mois}},{{jourR.annee}},'all','semaine_all',readData);" data-rel="popup_name" class="poplight lienCellule">
                                                {% else %}
                                                    <a class="lienCellule" style="border-bottom:1px solid #FFF" title="{{resa.bulle}}" href="vuereservation?id={{resa.idresa}}&amp;day={{jourR.jour}}&amp;month={{jourR.mois}}&amp;year={{jourR.annee}}&amp;page=semaine_all">
                                                {% endif %}
                                            {% endif %}
                                            {{resa.texte|raw}}
                                            {% if resa.lienFiche %}
                                                </a>
                                            {% endif %}

                                    </td>
                                </tr>
                            </table>
                        {% endfor %}
                        {% if jourR.horsResa %}
                            <div class="empty_cell">
                                <i class="fa-solid fa-xmark" title="{{'reservation_impossible'|trans}}" style="color:red"></i>
                            </div>
                        {% elseif jourR.plageLibre %}
                        <div class="empty_cell" data-day="{{jourR.jour}}" data-month="{{jourR.mois}}" data-year="{{jourR.annee}}" data-ressource="{{ressource.id}}" data-plage-libre="{{jourR.plageLibre ? '1' : '0'}}">
                            <a href="editentree?room={{ressource.id}}&amp;page=semaine_all&amp;year={{jourR.annee}}&amp;month={{jourR.mois}}&amp;day={{jourR.jour}}&amp;
                            {% if d.usePeriode == "y" %}
                                period=&amp;
                            {% else %}
                                hour={{jourR.heure}}&amp;minute=0
                            {% endif %}"
                            title="{{'cliquez_pour_effectuer_une_reservation'|trans}}"><i class="fa-solid fa-plus"></i></a>
                        </div>
                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
            {% endfor %}

		</tbody>


	</table>

		{% if d.pview != 1 %}
			<div id="toTop">
				<b>{{'top_of_page'|trans}}</b>
			</div>
		{% endif %}

	</div>
	<div id="popup_name" class="popup_block"></div>
</section>


{% endblock %}

{% block javascript %}
	{% if d.pview != 1 %}
		{{ planning.erreurMailAuto(settings, d.sessionMessageErreur) }}
		{{ planning.boutonRetourHaut() }}
        {{ planning.dragAndDrop(settings, d) }}
	{% endif %}
	{% if d.popupMessage %}
		{{ planning.popupMsg(settings, d.popupMessage, d.popupAffiche) }}
	{% endif %}
	<script type="text/javascript">
		$(document).ready(function(){
			$("#popup_name").draggable({containment: "#container"});
			$("#popup_name").resizable();
			afficheMenuHG('{{settings.menu_gauche}}');
			if ( $(window).scrollTop() == 0 )
				$("#toTop").hide(1);
		});
	</script>
{% endblock %}