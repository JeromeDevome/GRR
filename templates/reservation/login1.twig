{% import 'messagesysteme.twig' as msgSyst %}
{% import 'champs.twig' as form %}
<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="utf-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="Robots" content="noindex" />
		<title>GRR - {{ settings.company|raw }}</title>
		<link rel="manifest" href="./manifest.webmanifest">
		<meta name="theme-color" content="#1f5f8b">
		<link rel="stylesheet" href="./css/pwa-install.css">
		<link rel="shortcut icon" href="favicon.ico" />
		<link rel="stylesheet" type="text/css" href="./themes/default/css/style.css?v={{d.versionCache}}" />
		<link rel="stylesheet" type="text/css" href="./{{ d.sheetcss }}?v={{d.versionCache}}" />
		{{ d.sheetcssperso|raw }}
        <link rel="stylesheet" type="text/css" href="./jslib/fontawesome-free/css/all.min.css">
        <style>
            .btn-outlined-black {
                background-color: #fff;
                border: 1px solid #1f1e1f;
                color: #1f1e1f;
                padding: 8px 16px;
                line-height: 20px;
            }
        </style>
        {{ d.sheetcsspersocss|raw }}
	</head>

    <body>

        <div class="center">
            {% if settings.login_logo == "1" and settings.logo != ""  %}
                <img src="{{d.logo}}" alt="logo" style="max-height:200px;"/>
            {% endif %}
            <h1>{{settings.title_home_page}}</h1>
            {% if settings.login_nom == 1 %}
                <h2>{{settings.company|raw}}</h2>
            {% endif %}
            <p>{{settings.message_home_page|raw}}</p>

            {% if settings.disable_login == 1 %}
                <br><br><p><span class="avertissement">{{'msg_login3'|trans}}</span></p>
            {% endif %}

            {% if d.messageLogin %}
                <br><br><p><span class="avertissement">{{d.messageLogin|raw}}</span></p>
            {% endif %}

            <form action="app.php" method="post" style="width: 100%; margin-top: 24px; margin-bottom: 48px;">

                {% if d.url %}
                    <input type="hidden" name="url" value="{{d.url}}" />
                {% endif %}

                <fieldset style="padding-top: 8px; padding-bottom: 8px; width: 40%; margin-left: auto; margin-right: auto;">
                    <legend style="font-variant: small-caps;">{{'identification'|trans}}</legend>
                    <p>{{'mentions_legal_connexion'|trans}}</p>

                    <table style="width: 100%; border-collapse : separate;border-spacing : 10px;" cellpadding="5" cellspacing="0">

                        {{d.hookLienConnexion1|raw}}

                        {% if settings.sso_statut == "cas_visiteur" or settings.sso_statut == "cas_utilisateur" %}
                        <tr>
                            <td colspan="2">
                                <a class="btn btn-primary" type="submit" name="submit" href="index.php?force_authentification" style="font-variant: small-caps; width: 100%;" /><i class="fa-solid fa-address-card"></i> {{'authentification_CAS'|trans}}</a>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">{{'connect_local'|trans}}{{'deux_points'|trans}}</td>
                        </tr>
                        {% elseif settings.sso_statut == "lemon_visiteur" or settings.sso_statut == "lemon_utilisateur" %}
                        <tr>
                            <td colspan="2">
                                <a class="btn btn-primary" type="submit" name="submit" href="index.php" style="font-variant: small-caps; width: 100%;" /><i class="fa-solid fa-address-card"></i> {{'authentification_lemon'|trans}}</a>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">{{'connect_local'|trans}}{{'deux_points'|trans}}</td>
                        </tr>
                        {% elseif settings.sso_statut == "http_visiteur" or settings.sso_statut == "http_utilisateur" %}
                        <tr>
                            <td colspan="2">
                                <a class="btn btn-primary" type="submit" name="submit" href="index.php" style="font-variant: small-caps; width: 100%;" /><i class="fa-solid fa-address-card"></i> {{'authentification_lasso'|trans}}</a>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">{{'connect_local'|trans}}{{'deux_points'|trans}}</td>
                        </tr>
                        {% elseif settings.sso_statut == "lemon_visiteur" or settings.sso_statut == "sso_statut" %}
                        <tr>
                            <td colspan="2">
                                <a class="btn btn-primary" type="submit" name="submit" href="index.php" style="font-variant: small-caps; width: 100%;" /><i class="fa-solid fa-address-card"></i> {{'authentification_http'|trans}}</a>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2">{{'connect_local'|trans}}{{'deux_points'|trans}}</td>
                        </tr>
                        {% endif %}
                        <tr>
                            <td style="text-align: right; width: 40%; font-variant: small-caps;">{{'login'|trans}}</td>
                            <td style="text-align: center; width: 60%;"><input type="text" id="login" name="login" /></td>
                        </tr>
                        <tr>
                            <td style="text-align: right; width: 40%; font-variant: small-caps;">{{'pwd'|trans}}</td>
                            <td style="text-align: center; width: 60%;"><input type="password" name="password" /></td>
                        </tr>
                        <tr>
                            <td colspan="2">
                                <input class="btn btn-primary" type="submit" name="submit" value="{{'connect'|trans}}" />
                            </td>
                        </tr>

                    </table>
                    
                </fieldset>
            </form>

            {% if settings.fct_crea_cpt == 1 %}
                <h4><a href="creationcompte" class="btn btn-primary">{{'crea_compte_inscrivez'|trans}}</a></h4><br><br>
            {% endif %}

            {{ d.liensPerso2|raw }}
            <p>{{d.contactAdmin|raw}} [<a href="page?pageaffiche=cgu" target="_blank">{{'cgu'|trans}}</a>]</p>

            <a href="javascript:history.back()">{{'previous'|trans}} - <b>{{settings.company|raw}}</b></a>
            <br><br>
            <p class="small">{{'msg_login1'|trans|raw}}<a href="{{d.lienGRR}}">{{d.lienGRR}}</a></p>
        </div>

        {% include '_pwa_install.twig' %}
    </body>

    <script type="text/javascript" src="jslib/_grr/functions.min.js" ></script>
    <script type="text/javascript">
		document.getElementById('login').focus();
	</script>
</html>