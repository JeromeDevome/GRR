{% extends d.modePage == 1 
    ? 'layout.twig' 
    : 'layoutsimple.twig' %}

{% import 'messagesysteme.twig' as msgSyst %}
{% import 'champs.twig' as form %}

{% block css %}
{% endblock %}

{% block content %}

    {% if resa.resaSupprimer == 1 %}
        <div class="alert alert-danger" role="alert">Réservation supprimée</div>
    {% else %}

        {% if d.modePage == 1 %}
        <div class="container">
            {% if d.back != "" %}
                <div><a href="{{d.back|raw}}">{{'returnprev'|trans}}</a></div>
            {% endif %}
        {% endif %}

        <fieldset>
            <legend style="font-size:12pt;font-weight:bold">{{'entry'|trans}}{{'deux_points'|trans}} {{resa.breveDescription}}</legend>
            <table>
                <tr>
                    <th>{{'description'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.description|raw}}</td>
                </tr>
                <tr>
                    <th>{{'match_area'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.domaine|raw}}{% if resa.lienAreaPlanning %} <a href="{{resa.lienAreaPlanning}}"><i class="fa fa-eye" aria-hideen="true"></i></a>{% endif %}</td>
                </tr>
                <tr>
                    <th>{{'room'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.ressource|raw}}{% if resa.lienRoomPlanning %} <a href="{{resa.lienRoomPlanning}}"><i class="fa fa-eye" aria-hideen="true"></i></a>{% endif %}</td>
                </tr>
                <tr>
                    <th>{{'start_date'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.datedepart}}</td>
                </tr>
                <tr>
                    <th>{{'duration'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.duree}} {{resa.dureeunite}}</td>
                </tr>
                <tr>
                    <th>{{'end_date'|trans}}</th>
                    <td>{{resa.datefin}}</td>
                </tr>
                <tr>
                    <th>{{'type'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.type}}</td>
                </tr>
                {% if resa.beneficiaire %}
                <tr>
                    <th>{{'reservation_au_nom_de'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.beneficiaire|raw}}</td>
                </tr>
                {% endif %}
                <tr>
                    <th>{{'created_by'|trans}}{{'deux_points'|trans}}</th>
                    <td>
                        {{resa.createur|raw}} 
                        {% if resa.emprunte %}
                        <span class="avertissement">({{'reservation_en_cours'|trans}}) <i class="icone fa-solid fa-hand" title="{{'ressource_actuellement_empruntee'|trans}}"></i></a></span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>{{'lastupdate'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.derniereMAJ}}
                        {% if d.droitRessource > 2 %}
                            <a href="resahistorique?idresa={{resa.id}}"><i class="fa-solid fa-timeline"></i></a>
                        {% endif %}
                    </td>
                </tr>
                {% for champC in champscomp %}
                <tr>
                    <th>{{champC.nom}}{{'deux_points'|trans}}</th>
                    <td>{{champC.valeur}}</td>
                </tr>
                {% endfor %}
                {% if resa.clef == 1 %}
                <tr>
                    <th>{{'clef'|trans}}{{'deux_points'|trans}}</th>
                    <td><i class="icone fa-solid fa-key"></i></td>
                </tr>
                {% endif %}

                {% if resa.courrier == 1 %}
                <tr>
                    <th>{{'courrier'|trans}}{{'deux_points'|trans}}</th>
                    <td><i class="fa-solid fa-envelope"></i></td>
                </tr>
                {% endif %}

                {% if resa.delaisOption %}
                <tr>
                    <th colspan="2"><div class="alert alert-danger" role="alert">{{'reservation_a_confirmer_au_plus_tard_le'|trans}} {{resa.delaisOption}}</div></th>
                </tr>
                {% endif %}

            
                {% if resa.moderation == 1 %}
                <tr>
                    <th>{{'moderation'|trans}}{{'deux_points'|trans}}</th>
                    <td class="avertissement">{{'en_attente_moderation'|trans}}</td>
                </tr>
                {% endif %}

                {% if d.levelUser > 1 %}
                    {% if resa.moderation == 2 %}
                    <tr>
                        <th>{{'moderation'|trans}}{{'deux_points'|trans}}</th>
                        <td>
                            <strong>{{'moderation_acceptee_par'|trans}} {{resa.nomModo}}</strong>
                            {% if resa.commentaireModo %}
                                <br>({{resa.commentaireModo}})
                            {% endif %}
                        </td>
                    </tr>
                    {% elseif resa.moderation == 3 %}
                    <tr>
                        <th>{{'moderation'|trans}}{{'deux_points'|trans}}</th>
                        <td>
                            <strong>{{'moderation_refusee'|trans}} {{resa.nomModo}}</strong>
                            {% if resa.commentaireModo %}
                                <br>({{resa.commentaireModo}})
                            {% endif %}
                        </td>
                    </tr>
                    {% endif %}
                {% endif %}
            </table>

            {% if resa.nbParticipantMax > 0 %}
                <div>
                    <h4>{{'participants'|trans}}{{'deux_points'|trans}}</h4>
                    {% if d.participationValidation == 1 %}
                        <a class="btn btn-primary btn-xs" type="button" href="participation?id={{resa.id}}&amp;series=0&amp;page={{d.page}}&amp;room_back={{d.room_back}}" onclick="return confirm('{{'participant_confirm_validation'|trans}}');" />{{'participant_validation'|trans}}</a>
                    {% elseif d.participationAnnulation == 1 %}
                        <a class="btn btn-primary btn-xs" type="button" href="participation?id={{resa.id}}&amp;series=0&amp;page={{d.page}}&amp;room_back={{d.room_back}}" onclick="return confirm('{{'participant_confirm_annulation'|trans}}');" />{{'participant_annulation'|trans}}</a>
                    {% endif %}
                </div>
                <div>
                    <p><b>{{'participant_inscrit'|trans}}{{'deux_points'|trans}}</b> {{resa.nbParticipantInscrit}}/{{resa.nbParticipantMax}}</p>
                    <button type='button' class='btn btn-primary btn-sm' id='btn_liste_participe' onclick="toggle_visibility('liste_participants');toggle_visibility('btn_liste_participe');toggle_visibility('btn_close_liste');">{{'participant_list'|trans}}</button>
                    <button type='button' class='btn btn-primary btn-sm' id='btn_close_liste' style='display:none' onclick="toggle_visibility('liste_participants');toggle_visibility('btn_liste_participe');toggle_visibility('btn_close_liste');">{{'participant_list_hide'|trans}}</button>
                    <p id='liste_participants' style='display:none'>{{resa.listeParticipants|raw}}</p>

                    {% if d.quiPeutReserverPour == 1 %}
                        <button type='button' class='btn btn-primary btn-sm' id='btn_participe' onclick="toggle_visibility('form_participant');toggle_visibility('btn_participe');toggle_visibility('btn_close_participe');">{{'participant_register_form'|trans}}</button>
                        <button type='button' class='btn btn-primary btn-sm' id='btn_close_participe' style='display:none' onclick="toggle_visibility('form_participant');toggle_visibility('btn_participe');toggle_visibility('btn_close_participe');">{{'participant_register_form_hide'|trans}}</button>
                        <div id="form_participant" style="display:none">
                        <h3>{{'add_multiple_user_to_list'|trans}}{{'deux_points'|trans}}</h3>
                        <form action="app.php" method="GET">
                        <select id="avail_users" name="agent" size="8" style="width:200px;" class ="select2" multiple ondblclick="Deplacer(this.form.agent,this.form.elements['reg_participant[]'])">
                            {% for u in participantsDisponible %}
                                <option value="{{u.login}}">{{u.nomPrenom}}</option>
                            {% endfor %}
                        </select>
                        <input type="button" value="&lt;&lt;" onclick="Deplacer(this.form.elements['reg_participant[]'],this.form.agent)"/>
                        <input type="button" value="&gt;&gt;" onclick="Deplacer(this.form.agent,this.form.elements['reg_participant[]'])"/>
                        <select name="reg_participant[]" id="reg_participant" size="8" style="width:200px;" multiple="multiple" ondblclick="Deplacer(this.form.elements['reg_participant[]'],this.form.agent)">
                            {% for u in participantsEnregistrer %}
                                <option value="{{u.login}}">{{u.nomPrenom}}</option>
                            {% endfor %}
                        </select>
                        <input type="hidden" name="p" value="vuereservation" >
                        <input type="hidden" name="id" value="{{resa.id}}" >
                        <input type="hidden" name="mode" value="page" >
                        <input type="hidden" name="reg_part" value="valid">
                        <input type="submit" value="Enregistrer" onclick="selectionner_liste(this.form.reg_participant);" />
                        </form>
                        </div>
                        <p><hr></p>
                    {% endif %}
                </div>
            {% endif %}

            {% if d.uploadFile == 1 %}
                <div class="upload">
                    <h4>Choisissez le fichier que vous allez insérer dans cette réservation :</h4>
                    <form id="uploadForm" method="post" action="gestionfichier?action=1" enctype="multipart/form-data">
                        <input type="file" id="hiddenfile" style="display:none" name="myFiles[]" onChange="getvalue();"/>
                        <input type="button" value="Parcourir..." onclick="getfile();"/>
                        <input type="text" id="selectedfile" name="selectedfile" value="Nom du fichier" />
                        <input type="hidden" id = "id" name="id" value = "{{resa.id}}">
                        <input type="hidden" id = "area" name="area" value = "{{d.area}}">
                        <input type="hidden" id = "room_id" name="room_id" value = "{{d.room_id}}">
                        <input type="submit" value="Envoyer" id ="btnValidUpload" onChange="getvalue();">
                    </form>
                    <output id="infos"> </output>
                </div>
            {% endif %}
            {% if d.accessFile == 1 %}

                {% if d.countFile > 0 %}

                    <fieldset>
                        <h4>Fichiers joints :</h4>
                        <div class="col-sm-6 col-xs-12">

                            <table>
                            {% for file in attached_files %}
                                <tr>
                                    <td class="center"><a href="./personnalisation/{{d.gcDossierDoc}}/{{file.file_name}}" download="{{file.public_name}}">{{file.public_name}}</a></td>
                                    <td class="center"><a href="gestionfichier?action=2&amp;id={{file.id}}&amp;area={{d.area}}&amp;room_id={{d.room_id}}"><i class="fa fa-trash"></i></a></td>
                                </tr>
                            {% endfor %}
                            </table>

                            <output id="retourInfos"></output>
                        </div>
                    </fieldset>
                    <br/><br/>
                {% endif %}

            {% endif %}


        {% if d.accesBoutons == 1 %}
            <div>
                {% if d.lienModifier %}
                    <input class="btn btn-primary" type="button" onclick="location.href='{{d.lienModifier|raw}}'" value="{{'editentry'|trans}}"/>
                {% endif %}
                {% if d.lienCopier %}
                    <input class="btn btn-info" type="button" onclick="location.href='{{d.lienCopier|raw}}'" value="{{'copyentry'|trans}}"/>
                {% endif %}
                {% if settings.fct_echange_resa == 1 %}
                    {% if d.lienEchanger %}
                        <input class="btn btn-warning" type="button" onclick="location.href='{{d.lienEchanger|raw}}'" value="{{'swapentry'|trans}}"/>
                    {% endif %}
                {% endif %}
                {% if d.lienSupprimer %}
                    <a class="btn btn-danger" type="button" href="{{d.lienSupprimer|raw}}" onclick="return confirm('{{'confirmdel'|trans|e('js')}}\n{{'deleteentry'|trans}}');">{{'deleteentry'|trans}}</a>
                {% endif %}
            </div>
        {% endif %}
    </fieldset>

        {% if resa.idRepetition != 0 %}
        <fieldset>
            <legend style="font-weight:bold">{{'periodicite_associe'|trans}}</legend>
            <table>
                <tr>
                    <th>{{'rep_type'|trans}}</th>
                    <td>{{resa.typePeriode}}</td>
                </tr>
                {% if d.repDay %}
                <tr>
                    <th>{{d.repDay}}</th>
                    <td>{{resa.opt}}</td>
                </tr>
                {% endif %}
                <tr>
                    <th>{{'date'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.debutPeriode}}</td>
                </tr>
                <tr>
                    <th>{{'duration'|trans}}{{'deux_points'|trans}}</th>
                    <td>{{resa.dureePeriode}} {{resa.dureeUnitePeriode}}</td>
                </tr>
                <tr>
                    <th>{{'rep_end_date'|trans}}</th>
                    <td>{{resa.finPeriode}}</td>
                </tr>
                {% if d.lienPeriodeModifier %}
                <tr>
                    <td colspan="2">
                        <a class="btn btn-primary" type="button" href="{{d.lienPeriodeModifier|raw}}" onclick="return confirm('{{'confirmdel'|trans|e('js')}}\n{{'alterseries'|trans}}');">{{'editseries'|trans}}</a>
                    </td>
                </tr>
                {% endif %}
                {% if d.lienPeriodeSupprimer %}
                <tr>
                    <td colspan="2">
                        <a class="btn btn-danger" type="button" href="{{d.lienPeriodeSupprimerPosterieure|raw}}" onclick="return confirm('{{'confirmdel'|trans|e('js')}}\n{{'deleteseriesposterieure'|trans}}');">{{'deleteseriesposterieure'|trans}}</a>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <a class="btn btn-danger" type="button" href="{{d.lienPeriodeSupprimer|raw}}" onclick="return confirm('{{'confirmdel'|trans|e('js')}}\n{{'deleteseries'|trans}}');">{{'deleteseries'|trans}}</a>
                    </td>
                </tr>
                {% endif %}
            </table>
        </fieldset>
        {% endif %}

        {% if d.lienPDF %}
            <br><input class="btn btn-primary" onclick="lienPDF('{{resa.id}}')" value="{{'Generer_pdf'|trans}}" />
        {% endif %}

        {% if d.fin_session == 'n' %}
            <form action="app.php" method="get">
                <input type="hidden" name="p" value="vuereservation" />
                <input type="hidden" name="id" value="{{resa.id}}" />
                <input type="hidden" name="page" value="{{d.page}}" />

            {% if d.choixModeration %}
                <input type="hidden" name="action_moderate" value="y" />
                <fieldset>
                    <legend style="font-weight:bold">{{'moderate_entry'|trans}}</legend>
                    <p>
                        <input type="radio" name="moderate" value="1" checked="checked" />{{'accepter_resa'|trans}}
                        <br /><input type="radio" name="moderate" value="0" />{{'refuser_resa'|trans}}
                        {% if resa.idRepetition %}
                        <br /><input type="radio" name="moderate" value="S1" />{{'accepter_resa_serie'|trans}}
                        <br /><input type="radio" name="moderate" value="S0" />{{'refuser_resa_serie'|trans}}
                        {% endif %}
                    </p>
                    <p>
                        <label for="description">{{'justifier_decision_moderation'|trans}}{{'deux_points'|trans}}</label>
                        <textarea class="form-control" name="description" id="description" cols="40" rows="3"></textarea>
                    </p>
                </fieldset>
            {% endif %}
            {% if d.choixEmprunter %}
                <fieldset>
                    <legend style="font-weight:bold">{{'reservation_en_cours'|trans}}</legend>
                    <span class="larger">{{'signaler_reservation_en_cours'|trans}}{{'deux_points'|trans}}</span>
                    <br>{{'explications_signaler_reservation_en_cours'|trans | raw}}
                    {{d.ressourceEmpruntee|raw}}
                    <br><input type="radio" name="statut_id" value="-" {% if resa.idStatut == "-" %}{% if d.ressourceEmprunteeYes !="yes" %}checked="checked"{% endif %}{% endif %} />{{'signaler_reservation_en_cours_option_0'|trans | raw}}
                    <br><br><input type="radio" name="statut_id" value="y" {% if resa.idStatut == "y" %}checked="checked"{% endif %} />{{'signaler_reservation_en_cours_option_1'|trans}}
                    <br><br><input type="radio" name="statut_id" value="e" {% if resa.idStatut == "e" %}checked="checked"{% endif %} {% if settings.automatic_mail != 1 or d.mailBeneficiaire == "" %}checked="checked"{% endif %} />{{'signaler_reservation_en_cours_option_2'|trans}}

                    {% if settings.automatic_mail != 1 or d.mailBeneficiaire == "" %}
                        <br><i>({{'necessite_fonction_mail_automatique'|trans}})</i>
                    {% endif %}
                    {% if settings.automatic_mail == 1 %}
                        <br><br><input type="checkbox" name="envoyer_mail" value="y" {% if d.mailBeneficiaire == "" %}disabled{% endif %} />{{ 'envoyer_maintenant_mail_retard'|trans }}
                        <input type="hidden" name="mail_exist" value="{{d.mailBeneficiaire}}" />
                    {% endif %}
                </fieldset>
            {% endif %}
            {% if d.choixEmprunter and d.clefCourrier == 1 %}
                <fieldset>
                    {% if resa.ressourceClef == "y" %}
                        <br><span class="larger">{{'status_clef'|trans}}{{'deux_points'|trans}}</span>
                        <br><input type="checkbox" name="clef" value="y" {% if resa.clef == 1 %}checked{% endif %} /> {{'msg_clef'|trans}}
                    {% endif %}

                    {% if settings.show_courrier == 1 %}
                        <br><span class="larger">{{'status_courrier'|trans}}{{'deux_points'|trans}}</span>
                        <br><input type="checkbox" name="courrier" value="y" {% if resa.courrier == 1 %}checked{% endif %} /> {{'msg_courrier'|trans}}
                    {% endif %}
                </fieldset>
            {% endif %}

                <input type="hidden" name="day" value="{{d.day}}" />
                <input type="hidden" name="month" value="{{d.month}}" />
                <input type="hidden" name="year" value="{{d.year}}" />
                <input type="hidden" name="back" value="{{d.back}}" />
                {% if d.choixEmprunter and d.clefCourrier == 1 or d.choixModeration %}
                    <br /><div style="text-align:center;"><input class="btn btn-primary" type="submit" name="commit" value="{{'save'|trans}}" /></div>
                {% endif %}
            </form>
        {% endif %}

        {% if d.modePage == 1 %}
            </div>
        {% endif %}
    {% endif %}

{% endblock %}

{% block javascript %}
{% endblock %}
