{% extends 'layout.twig' %}

{% import 'messagesysteme.twig' as msgSyst %}

{% block css %}
{% endblock %}

{% block content %}

	<div class="row">
		<div class="col col-md-12">

			<div class="box">
				<!-- /.box-header -->
				<div class="box-body no-padding">

					{% if d.nbSite > 1 %}
						<div class="form-group row">
							<label class="col col-md-2" for="site">{{ trad.sites }}</label>
							<div class="col col-md-10">
								<form id="liste_site" action="admin.php?p=admin_room">
									<select name="id_site" class="form-control" onchange="site_go()">
										<option value="-1">{{ trad.choose_a_site }}</option>
										{% for site in sites %}
											<option value="{{ site.idsite }}" {% if site.idsite == d.idSite %} selected {% endif %}>{{ site.nomsite }}</option>
										{% endfor %}
									</select>
								</form>
							</div>
						</div>
					{% endif %}

					{% if settings.module_multisite != 1 or (settings.module_multisite == 1 and d.idSite > 0) %}
						<!-- Affichage des domaines et des ressources -->
						<div class="mb-2 text-right">
							<div class="btn-group btn-group-sm" role="group">
								<button type="button" class="btn btn-default" onclick="expandAllDomaines(); return false;"><i class="fa fa-angles-down"></i> Déplier tout</button>
								<button type="button" class="btn btn-default" onclick="collapseAllDomaines(); return false;"><i class="fa fa-angles-up"></i> Replier tout</button>
								{% if d.ajoutDomaine == 1 %}
									<a class="btn btn-success" href="?p=admin_edit_domaine&amp;id_site={{d.idSite}}&amp;add_area=yes"><i class="fa fa-add"></i> {{trad.addarea}}</a>
								{% else %}
									<a href="#" class="btn btn-secondary"><i class="fa fa-add"></i> {{trad.addarea}}</a>
								{% endif %}
							</div>
						</div>

						<div id="accordion-domaines" class="accordion">
							{% for domaine in domaines %}
								<div class="card mb-2">
									<!-- Domaines -->
									<div class="card-header p-2">
										<div class="d-flex justify-content-between align-items-center">
											{% if domaine.acces == 'r' %}<a class="btn btn-primary btn-sm" href="?p=admin_access_area&amp;id_area={{ domaine.id }}" title="{{ trad.admin_access_area }}"><span class="fa fa-lock"></a>{% else %}&nbsp;{% endif %}
											<button class="btn btn-link text-left p-0 text-dark text-decoration-none domaine-toggle" type="button" data-target="#collapse-domaine-{{ domaine.id }}" aria-expanded="{{ domaine.id == d.idDomaine ? 'true' : 'false' }}" aria-controls="collapse-domaine-{{ domaine.id }}" onclick="toggleDomaineCollapse('#collapse-domaine-{{ domaine.id }}'); return false;">		
												<h5 class="text-primary">{{ domaine.nom }} <i class="fa chevron-icon {% if domaine.id == d.idDomaine %}fa-angles-up{% else %}fa-angles-down{% endif %}"></i></h5>
											</button>
											<div class="btn-group btn-group-sm" role="group">
												<a class="btn btn-primary" href="?p=admin_edit_domaine&amp;id_site={{ d.idSite }}&amp;id_area={{ domaine.id }}" title="{{ trad.edit }}"><span class="fa fa-edit"></span></a>
												{% if domaine.droitsuser >= 5 %}
													<a class="btn btn-success" href="?p=admin_edit_domaine&amp;id_area={{ domaine.id }}&amp;action=duplique_area" title="{{ trad.duplique_domaine }}"><span class="fa fa-copy"></span></a>
													<a class="btn btn-danger" href="?p=admin_room_del&amp;id_site={{ d.idSite }}&amp;type=area&amp;id_area={{ domaine.id }}" title="{{ trad.delete }}"><span class="fa fa-trash"></span></a>
												{% else %}
													<a class="btn btn-secondary" href="#" title="{{ trad.copy }}"><span class="fa fa-copy"></span></a>
													<a class="btn btn-secondary" href="#" title="{{ trad.delete }}"><span class="fa fa-trash"></span></a>
												{% endif %}
												<a class="btn btn-primary" href="?p=admin_type_area&amp;id_area={{ domaine.id }}" title="{{ trad.admin_type_area }}"><span class="fa fa-tags"></span></a>
												<a class="btn btn-info" href="javascript:centrerpopup('../app.php?p=vuedroitsdomaine&amp;area_id={{ domaine.id }}',600,480,'scrollbars=yes,statusbar=no,resizable=yes')" title="{{ trad.privileges }}"><span class="fas fa-user-shield"></span></a>
											</div>
										</div>
									</div>
									<!-- Ressources -->
									<div id="collapse-domaine-{{ domaine.id }}" class="domaine-collapse collapse {% if domaine.id == d.idDomaine %}show{% endif %}" data-parent="#accordion-domaines">
										<div class="card-body p-2">
											{% set ressourceExiste = 0 %}
											<table class="table table-sm mb-0">
												{% for ressource in ressources %}
													{% if ressource.iddomaine == domaine.id %}
														{% set ressourceExiste = 1 %}
														<tr>
															<td width="80px">
																{% if ressource.resteint == '0' %}<a class="btn btn-primary btn-sm" href="?p=admin_book_room&amp;id_room={{ ressource.id }}" title="{{ trad.admin_access_area }}"><span class="fa fa-lock"></a>{% endif %}
																{% if ressource.statut == 0 %}<span class="fa fa-ban" style="color:red;"></span>{% endif %}
																{% if ressource.confidentiel_resa == 1 %}<span class="fa fa-user-secret" style="color:green;"></span>{% endif %}
															</td>
															<td>{{ ressource.nom }} <i>{{ ressource.description }} {% if ressource.capacite > 0 %}({{ ressource.capacite }} max.){% endif %}</i></td>
															<td class="text-right">
																<div class="btn-group btn-group-sm" role="group">
																	<a class="btn btn-primary btn-sm" href="?p=admin_edit_room&amp;room={{ ressource.id }}" title="{{ trad.edit }}"><span class="fa fa-edit"></span></a>
																	<a class="btn btn-success btn-sm" href="?p=admin_edit_room&amp;room={{ ressource.id }}&amp;action=duplique_room" title="{{ trad.duplique_ressource }}"><span class="fa fa-copy"></span></a>
																	<a class="btn btn-danger btn-sm" href="?p=admin_room_del&amp;type=room&amp;room={{ ressource.id }}&amp;id_area={{ domaine.id }}" title="{{ trad.delete }}"><span class="fa fa-trash"></span></a>
																	<a class="btn btn-info btn-sm" href="javascript:centrerpopup('../app.php?p=vuedroitsressource&amp;id_room={{ ressource.id }}',600,480,'scrollbars=yes,statusbar=no,resizable=yes')" title="{{ trad.privileges }}"><span class="fas fa-user-shield"></span></a>
																	<a class="btn btn-info btn-sm" href="javascript:centrerpopup('../app.php?p=ressourcefiche&amp;id_room={{ ressource.id }}',600,480,'scrollbars=yes,statusbar=no,resizable=yes')" title="{{ trad.fiche_ressource }}"><span class="fa fa-newspaper"></span></a>
																</div>
															</td>
														</tr>
													{% endif %}
												{% endfor %}
											</table>
											{% if ressourceExiste == 0 %}
												<div class="mt-2 text-muted">{{ trad.no_rooms_for_area }}</div>
											{% endif %}
											<div class="mt-2">
												<a href="?p=admin_edit_room&amp;id_site={{ d.idSite }}&amp;area_id={{ domaine.id }}" class="btn btn-sm btn-success">{{ trad.addroom }}</a>
											</div>
										</div>
									</div>
								</div>
							{% endfor %}
						</div>
					{% endif %}

				</div>
			</div>
		</div>
	</div>

	<!-- Activer  / désactiver site -->
	<div class="row">
		<div class="col col-12 col-sm-12">
			<div class="card card-warning card-outline card-tabs">
				<table class="table table-striped">
					<tr>
					<th>{{trad.name}}</th>
					<th>{{trad.sum_by_descrip}}</th>
					<th>{{trad.action}}</th>
					</tr>

					<tr>
					<td>{{trad.Activer_module_multisite}}</td>
					<td>{{trad.explain_multisite}}</td>
					<td>
						<div class="form-group">
							<div class="custom-control custom-switch">
							<input type="checkbox" class="custom-control-input" id="p_module_multisite" onclick='window.location.assign("?p=admin_room&amp;p_module_multisite=1")' {% if settings.module_multisite == 1 %} checked {% endif %} > 
							<label class="custom-control-label" for="p_module_multisite"></label>
							</div>
						</div>
					</td>
					</tr>
				</table>
			</div>
		</div>
	</div>

        <div class="modal modal-warning fade" id="modal-warning">
		<form action="?p=admin_type">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                  <span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">{{trad.confirm_del}}</h4>
              </div>
              <div class="modal-body">
				<span id="modal-texte"></span><span id="modal-idsup" class="hidden"></span> 
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline pull-left" data-bs-dismiss="modal">{{trad.cancel}}</button>
				<button type="submit" id="liensup" class="btn btn-outline">{{trad.delete}}</button>
              </div>
            </div>
          </div>
		  </form>
        </div>
{% endblock %}

{% block javascript %}
	<script type="text/javascript">
		{% if d.enregistrement %}
			{% if d.enregistrement == 1 %}
				toastr.success("{{d.msgToast|raw}}")
			{% else %}
				toastr.warning("{{d.msgToast|raw}}")
			{% endif %}
		{% endif %}

		function toggleDomaineCollapse(targetId) {
			var target = document.querySelector(targetId);
			if (!target) return false;

			var shouldOpen = !target.classList.contains('show');
			target.classList.toggle('show', shouldOpen);

			document.querySelectorAll('.domaine-toggle').forEach(function (button) {
				var isTarget = button.getAttribute('data-target') === targetId;
				if (isTarget) {
					button.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
					var icon = button.querySelector('.chevron-icon');
					if (icon) {
						icon.classList.toggle('fa-angles-down');
						icon.classList.toggle('fa-angles-up');
					}
				}
			});
			return false;
		}

		function expandAllDomaines() {
			document.querySelectorAll('.domaine-collapse').forEach(function (element) {
				element.classList.add('show');
			});
			document.querySelectorAll('.domaine-toggle').forEach(function (button) {
				button.setAttribute('aria-expanded', 'true');
				var icon = button.querySelector('.chevron-icon');
				if (icon) {
					icon.classList.remove('fa-angles-down');
					icon.classList.add('fa-angles-up');
				}
			});
		}

		function collapseAllDomaines() {
			document.querySelectorAll('.domaine-collapse').forEach(function (element) {
				element.classList.remove('show');
			});
			document.querySelectorAll('.domaine-toggle').forEach(function (button) {
				button.setAttribute('aria-expanded', 'false');
				var icon = button.querySelector('.chevron-icon');
				if (icon) {
					icon.classList.add('fa-angles-down');
					icon.classList.remove('fa-angles-up');
				}
			});
		}

		function site_go()
		{
			box = document.getElementById("liste_site").id_site;
			destination = "?p=admin_room"+"&id_site="+box.options[box.selectedIndex].value;
			location.href = destination;
		}

		function centrerpopup(page,largeur,hauteur,options)
		{
		// les options :
		//    * left=100 : Position de la fenêtre par rapport au bord gauche de l'écran.
		//    * top=50 : Position de la fenêtre par rapport au haut de l'écran.
		//    * resizable=x : Indique si la fenêtre est redimensionnable.
		//    * scrollbars=x : Indique si les barres de navigations sont visibles.
		//    * menubar=x : Indique si la barre des menus est visible.
		//    * toolbar=x : Indique si la barre d'outils est visible.
		//    * directories=x : Indique si la barre d'outils personnelle est visible.
		//    * location=x : Indique si la barre d'adresse est visible.
		//    * status=x : Indique si la barre des status est visible.
		//
		// x = yes ou 1 si l'affirmation est vrai ; no ou 0 si elle est fausse.
		var top = (screen.height - hauteur) / 2;
		var left = (screen.width - largeur) / 2;
		window.open(page,"","top="+top+",left="+left+",width="+largeur+",height="+hauteur+",directories=no,toolbar=no,menubar=no,location=no,"+options);
		}
	</script>
{% endblock %}