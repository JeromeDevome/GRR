{% extends 'layout.twig' %}

{% import 'messagesysteme.twig' as msgSyst %}
{% import 'champs.twig' as form %}

{% block css %}
{% endblock %}

{% block content %}
	<div class="row">
		<div class="card col-12">

			<form class="form-horizontal" method="post">
				<input type="hidden" name ="p" value="admin_groupe_edit" />
				<input type="hidden" name ="p_idgroupe" value="{{groupe.idgroupes}}" />

				<div class="card-body">
					{{ form.input('p_nom', trad.name, groupe.nom, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label', require:1}) }}
					{{ form.textarea('p_description', trad.description, groupe.description, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label'}) }}
					{{ form.switch('p_archive', trad.archiver, groupe.archive, {classGroup: 'col-12 custom-switch-on-danger', classLabel: 'col-10', classDivInput: 'col-2'}) }}
				</div>
				<div class="card-footer">
					<a href="?p=admin_groupe" name="back" class="btn btn-default btn-md" /><i class="fas fa-circle-left"></i> {{ trad.back }}</a>
					<button type="submit" name="p_submit" value="1" class="btn btn-success btn-md float-right" /><i class="fas fa-save"></i> {{ trad.save }}</button>
				</div>
			</form>

		</div>
	</div>
{% endblock %}

{% block javascript %}
	<script>
		$(function () {
			{%if d.enregistrement == 1 %}
				toastr.success("{{trad.message_records}}")
			{%elseif d.enregistrement == 2 %}
				toastr.error("{{trad.groupe_exist}}")
			{%elseif d.enregistrement == 3 %}
				toastr.error("{{trad.please_enter_name}}")
			{%endif%}
		}); 
	</script>
{% endblock %}