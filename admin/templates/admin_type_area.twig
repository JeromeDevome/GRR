{% extends 'layout.twig' %}

{% block css %}
{% endblock %}

{% import 'messagesysteme.twig' as msgSyst %}

{% block content %}
	<div class="row">
		<div class="col col-md-12">
			<div class="callout callout-info">{{trad.explications_active_type}}</div>

			<div class="card">
				<div class="card-header">
					{% if d.droitsAdmin >= 6 %}
						<a class="btn pull-right bg-green" href="?p=admin_type_modify"><i class="icon fa fa-plus"></i> {{trad.display_add_type}}</a>
					{% endif %}
				</div>
				<form action="?p=admin_type_area" id="type" method="post">
					<div class="card-body">

						<input type="hidden" name="p" value="admin_type_area" />
						<input type="hidden" name="p_id_area" value="{{d.idArea}}" />

						<table class="table table-striped">
							<tr>
							  <th style="width: 10px">{{trad.type_num}}</th>
							  <th>{{trad.type_name}}</th>
							  <th style="width: 20px">{{trad.type_color}}</th>
							  <th>{{trad.type_order}}</th>
							  <th>{{trad.type_valide_domaine}}</th>
							  <th>{{trad.type_par_defaut}}</th>
							</tr>
							{% for type in types %}
								<tr>
									<td>{{type.type_letter}}</td>
									<td>{{type.type_name}}</td>
									<td style="background-color:{{type.couleurhexa}};color:{{type.couleurtexte}};">Texte</td>
									<td>{{type.order_display}}</td>
									<td><input type="checkbox" name="p_types[]" value="{{ type.id }}" {% if type.dispodomaine < 1 %}checked{% endif %} /></td>
									<td><input type="radio" name="p_id_type_par_defaut" value="{{ type.id }}" {% if d.defautType == type.id %}checked{% endif %} /></td>
								</tr>
							{% endfor %}
							<tr>
								<td></td>
								<td></td>
								<td></td>
								<td></td>
								<td></td>
								<td><input type="radio" name="p_id_type_par_defaut" value="-1"{% if d.defautType <= 0 %}checked{% endif %} /> {{ trad.nobody }}</td>
							</tr>
						</table>
					</div>
					<div class="card-footer">
						<a href="?p=admin_room" name="back" class="btn btn-default btn-md" /><i class="fas fa-circle-left"></i> {{ trad.back }}</a>
						<button type="submit" name="p_submit" value="1" class="btn btn-primary btn-md float-right" /><i class="fas fa-save"></i> {{ trad.save }}</button>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascript %}
	<script>
		$(function () {
			{% if d.enregistrement == 1 %}
				toastr.success("{{d.msgToast}}")
			{% elseif d.enregistrement == 2 %}
				toastr.warning("{{d.msgToast}}")
			{% elseif d.enregistrement == 3 %}
				toastr.error("{{d.msgToast}}")
			{% endif %}
		});
	</script>
{% endblock %}