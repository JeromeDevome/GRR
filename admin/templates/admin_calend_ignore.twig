{% extends 'layout.twig' %}

{% import 'messagesysteme.twig' as msgSyst %}
{% import 'champs.twig' as form %}

{% block css %}{% endblock %}

{% block content %}
	<div class="row">
		<div class="col col-md-12">

			<div class="card">
				<div class="card-header">
					<p class="text-muted mb-3">{{ trad.les_journees_cochees_sont_ignorees |raw }}</p>

					{{ msgSyst.messageAlerte(trad.attention, trad.les_journees_cochees_sont_ignorees_warning) }}

	
						{% for jour in jourssemaines %}
							<div class="btn-group btn-group-xs mb-1 mr-1" role="group" aria-label="{{ jour }}">
								<a href="?p=admin_calend_ignore" class="btn btn-info btn-sm" onclick="setCheckboxesGrr(document.getElementById('formulaire'), true, '{{ jour }}'); return false;">
									{{ trad.check_all_the }} {{ jour }}s
								</a>
								<a href="?p=admin_calend_ignore" class="btn btn-default btn-sm" onclick="setCheckboxesGrr(document.getElementById('formulaire'), false, '{{ jour }}'); return false;">
									{{ trad.uncheck_all_the }} {{ jour }}s
								</a>
							</div>
						{% endfor %}

						{% if settings.show_feries == 1 %}
							<div class="btn-group btn-group-xs mb-1 mr-1" role="group" aria-label="vacances">
								<a href="?p=admin_calend_ignore" class="btn btn-info btn-sm" onclick="{{ d.Cocheferies }} return false;">
									{{ trad.check_all_the }} {{ trad.holidays }}
								</a>
								<a href="?p=admin_calend_ignore" class="btn btn-default btn-sm" onclick="{{ d.Decocheferies }} return false;">
									{{ trad.uncheck_all_the }} {{ trad.holidays }}
								</a>
							</div>
						{% endif %}

						{% if settings.show_holidays == 1 %}
							<div class="btn-group btn-group-xs mb-1 mr-1" role="group" aria-label="vacances">
								<a href="?p=admin_calend_ignore" class="btn btn-info btn-sm" onclick="{{ d.CocheVacances }} return false;">
									{{ trad.check_all_the }} {{ trad.school_holidays }}
								</a>
								<a href="?p=admin_calend_ignore" class="btn btn-default btn-sm" onclick="{{ d.DecocheVacances }} return false;">
									{{ trad.uncheck_all_the }} {{ trad.school_holidays }}
								</a>
							</div>
						{% endif %}

						<div class="btn-group btn-group-xs mb-1" role="group" aria-label="reset">
							<a href="?p=admin_calend_ignore" class="btn btn-warning btn-sm" onclick="setCheckboxesGrr(document.getElementById('formulaire'), false, 'all'); return false;">
								{{ trad.uncheck_all_ }}
							</a>
						</div>


						<form action="?p=admin_calend_ignore" method="post" id="annee">
							<input type="hidden" name="p" value="admin_calend_ignore" />
							{{ trad.annee }} 
							{{d.liste_annees |raw }}
							<input class="btn-sm btn-primary" type="submit" name="{{ trad.OK }}" value="{{ trad.OK }}" />
						</form>
					</div>
					<div class="card-body p-0">
						<form action="?p=admin_calend_ignore" method="post" id="formulaire">
							<input type="hidden" name="p" value="admin_calend_ignore" />
							<input type="hidden" name="From_year" value="{{ d.From_year }}" />
							<input type="hidden" name="p_submit" value="1" />
							<div class="row">
								{{ d.calendrier |raw }}
							</div>
							<!-- Enregistrer -->
							<button type="submit" name="ok" class="btn btn-primary position-fixed elevation-4" style="bottom:70px; right:20px; z-index:99;">
								<i class="fas fa-save"></i> {{ trad.save }}
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}

{% block javascript %}
<script>
	$(function () {
		{%if d.enregistrement == 1 %}
			toastr.success("{{trad.message_records}}")
		{% elseif d.enregistrement == 2 %}
			toastr.warning("{{d.enregistrement|raw}}")
		{% elseif d.enregistrement == 3 %}
			toastr.warning("{{d.enregistrement|raw}}")
		{% endif %}
	});

	function setCheckboxesGrr(elts, do_check, day)
	{
		for (i = 0; i < elts.length; i++)
		{
			type = elts.type;
			if (type="checkbox")
			{
				if ((elts[i].value== day) || (day=='all'))
				{
					elts[i].checked = do_check;
				}
			}
		}
		return true;
	}

	function setCheckboxesGrrName(elts, do_check, day)
	{
		for (i = 0; i < elts.length; i++)
		{
			type = elts.type;
			if (type="checkbox")
			{
				if (elts[i].name== day)
				{
					elts[i].checked = do_check;
				}
			}
		}
		return true;
	}
</script>
{% endblock %}