		</div>
		<!-- Enregistrer -->
		<a href="?p=admin_room{% if d.idSite %}&amp;id_site={{ d.idSite }}{% endif %}" class="btn btn-default position-fixed elevation-4" style="bottom:125px; right:20px; z-index:99;">
			<i class="fas fa-circle-left"></i> {{ trad.back }}
		</a>
		<button type="submit" name="p_submit" value="1" class="btn btn-primary position-fixed elevation-4" style="bottom:70px; right:20px; z-index:99;">
			<i class="fas fa-save"></i> {{ trad.save }}
		</button>
	</form>

{% endblock %}

{% block javascript %}
	<script>
		$(function () {
			{%if d.enregistrement %}
				{%if d.enregistrement == 1 %}
					toastr.success("{{trad.message_records}}")
				{% else %}
					toastr.warning("{{d.enregistrement|raw}}")
				{%endif%}
			{%endif%}

			// Afficher/masquer la section de création de compte
			var $switchFicJoint = $('input[name="p_access_file"]');
			var $sectionFicJoint = $('#aff_dyn_fichier_joint');
			$sectionFicJoint.toggle($switchFicJoint.is(':checked'));

			// À la modification du switch
			$switchFicJoint.on('change', function() {
				if ($(this).is(':checked')) {
					$sectionFicJoint.slideDown();
				} else {
					$sectionFicJoint.slideUp();
				}
			});
		}); 

		aff_creneaux();

		function bascule()
		{
			heure1 = document.getElementById('heure1');
			heure2 = document.getElementById('heure2');
			intitule1 = document.getElementById('intitule1');
			intitule2 = document.getElementById('intitule2');
			if (document.getElementById('main').p_enable_periods[0].checked)
			{
				heure1.style.display = "";
				heure2.style.display = "";
				intitule1.style.display = "none";
				intitule2.style.display = "none";
			}
			if (document.getElementById('main').p_enable_periods[1].checked)
			{
				heure1.style.display = "none";
				heure2.style.display = "none";
				intitule1.style.display = "";
				intitule2.style.display = "";
			}
			alert("{{ trad.avertissement_change_type }}");
		}

		function aff_creneaux()
		{
			nb_cr = document.getElementById('p_number_periodes');
			if (isNaN(Number(nb_cr.value)))
				nb_cr.value = 1;
			if (nb_cr.value > 50)
				nb_cr.value = 50;
			if (nb_cr.value < 1)
				nb_cr.value = 1;
			for (var i = 1; i <= nb_cr.value; i++)
			{
				document.getElementById('c' + i).style.display = '';
			}
			for (var i; i <= 50; i++)
			{
				document.getElementById('c' + i).style.display = 'none';
			}
			return false;
		}
	</script>
{% endblock %}