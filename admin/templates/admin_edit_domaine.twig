								<small>{{ trad.ip_adr_explain |raw }}</small>
								<hr>
							{% endif %}

							<h5>Restrictions</h5>
							<small class="text-muted">{{ trad.noAdminRestrict }}</small><br><br>

							{{ form.input('p_max_booking', trad.max_booking, domaine.max_booking, {classGroup: 'col-sm-12', classLabel: 'col-sm-9', classDivInput: 'col-sm-3 control-label', type: 'number', min: '-1'}) }}
						
							<div {% if domaine.enable_periods == 'y' %} style="display:none;" {% endif %} id="heure2">
								{{ form.input('p_duree_max_resa_area1', trad.duree_max_resa_area, domaine.duree_max_resa_area, {classGroup: 'col-sm-12', classLabel: 'col-sm-9', classDivInput: 'col-sm-3 control-label', type: 'number', min: '-1'}) }}
							</div>
							<div {% if domaine.enable_periods == 'n' %} style="display:none;" {% endif %} id="intitule2">
								{{ form.input('p_duree_max_resa_area2', trad.duree_max_resa_area2, d.nombreJourMax, {classGroup: 'col-sm-12', classLabel: 'col-sm-9', classDivInput: 'col-sm-3 control-label', type: 'number', min: '-1'}) }}
							</div>
						</div>
					</div>
				</div>
