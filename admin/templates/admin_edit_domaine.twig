{% extends 'layout.twig' %}

{% import 'messagesysteme.twig' as msgSyst %}
{% import 'champs.twig' as form %}

{% block css %}
{% endblock %}

{% block content %}

	<form action="?p=admin_edit_domaine" method="post" id="main">
		<input type="hidden" name="p" value="admin_edit_domaine" />
		<input type="hidden" name="p_action" value="{{ d.action }}" />
		<input type="hidden" name="p_id_area" value="{{ domaine.id }}" />

		<div class="row">
			<div class="col col-xl-6 col-lg-12 col-md-12 col-sm-12 col-xs-12">

				<!-- Bloc informations -->
				<div class="col col-md-12">
					<div class="card">
						<div class="card-header">
							<h3 class="card-title"><i class="fas fa-newspaper"></i> {{ trad.miscellaneous }}</h3>
						</div>
						<div class="card-body">

							{% if settings.module_multisite == 1 %}
								<div class="form-group row col-sm-12">
									<label class="col col-sm-4" for="p_id_site">{{ trad.site }}</label>
									<div class="col col-sm-8">
										<select class="form-control" name="p_id_site">
											<option value="-1">{{ trad.choose_a_site }}</option>
											{% for site in sites %}
												<option value="{{ site.id }}" {% if d.idSite ==  site.id %} selected {% endif %}>{{ site.nom }}</option>
											{% endfor %}
										</select>
									</div>
								</div>
							{% endif %}

							{{ form.input('p_area_name', trad.name, domaine.area_name, {classGroup: 'col-sm-12', classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label', require:1}) }}
							{{ form.input('p_area_order', trad.order_display, domaine.order_display, {classGroup: 'col-sm-12', classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label', type: 'number', min: 0}) }}
							<div class="form-group row col-sm-12">
								<label class="col col-sm-4" for="p_access">{{ trad.access }}</label>
								<div class="col col-sm-8">
									<input type="checkbox" name="p_access" value="r" {% if domaine.access == 'r' %} checked {% endif %}>
								</div>
							</div>

						</div><!-- /.card-body -->
					</div>
				</div>

				<!-- Bloc configuration des plages horaires -->
				<div class="col col-md-12">
					<div class="card">
						<div class="card-header">
							<h3 class="card-title"><i class="fas fa-clock"></i> {{ trad.configuration_plages_horaires }}</h3>
						</div>
						<div class="card-body">

							<div class="form-group row col-sm-12">
								<label class="col col-sm-4" for="p_weekstarts_area">{{ trad.weekstarts_area }}</label>
								<div class="col col-sm-8">
									<select class="form-control" name="p_weekstarts_area">
										{% for jour in JoursSemaine %}
											<option value="{{ jour.num }}" {% if domaine.weekstarts_area ==  jour.num %} selected {% endif %}>{{ jour.nom }}</option>
										{% endfor %}
									</select>
								</div>
							</div>
							<div class="form-group row col-sm-12">
								<label class="col col-sm-8" for="p_display_day">{{ trad.cocher_jours_a_afficher |raw }}</label>
								<div class="col col-sm-4">
									{% for jour in JoursSemaine %}
										<input name="p_display_day[{{ jour.num }}]" type="checkbox" {% if domaine.display_days|slice(jour.num, 1) ==  'y' %} checked {% endif %}> {{ jour.nom }}<br>
									{% endfor %}
								</div>
							</div>

							<hr>

							<h5>{{ trad.type_de_creneaux }}</h5>
							<input type="radio" name="p_enable_periods" value="n" onclick="bascule()" id="label_1a" {% if domaine.enable_periods == 'n' %} checked {% endif %} /> <label for="label_1a">{{ trad.creneaux_de_reservation_temps }}</label><br>
							<input type="radio" name="p_enable_periods" value="y" onclick="bascule()" id="label_1b" {% if domaine.enable_periods == 'y' %} checked {% endif %} /> <label for="label_1b">{{ trad.creneaux_de_reservation_pre_definis }}</label><br>

							<blockquote class="quote-info">
								<!-- CAS 1 Basé sur le temps -->
								<div {% if domaine.enable_periods == 'y' %} style="display:none;" {% endif %} id="heure1">
									<div class="form-group row col-sm-12">
										<label class="col col-sm-10" for="p_morningstarts_area">{{ trad.morningstarts_area }}</label>
										<div class="col col-sm-2">
											<select class="form-control" name="p_morningstarts_area">
												<option value="0" {% if domaine.morningstarts_area == 0 %} selected {% endif %}>0</option>
												<option value="1" {% if domaine.morningstarts_area == 1 %} selected {% endif %}>1</option>
												<option value="2" {% if domaine.morningstarts_area == 2 %} selected {% endif %}>2</option>
												<option value="3" {% if domaine.morningstarts_area == 3 %} selected {% endif %}>3</option>
												<option value="4" {% if domaine.morningstarts_area == 4 %} selected {% endif %}>4</option>
												<option value="5" {% if domaine.morningstarts_area == 5 %} selected {% endif %}>5</option>
												<option value="6" {% if domaine.morningstarts_area == 6 %} selected {% endif %}>6</option>
												<option value="7" {% if domaine.morningstarts_area == 7 %} selected {% endif %}>7</option>
												<option value="8" {% if domaine.morningstarts_area == 8 %} selected {% endif %}>8</option>
												<option value="9" {% if domaine.morningstarts_area == 9 %} selected {% endif %}>9</option>
												<option value="10" {% if domaine.morningstarts_area == 10 %} selected {% endif %}>10</option>
												<option value="11" {% if domaine.morningstarts_area == 11 %} selected {% endif %}>11</option>
												<option value="12" {% if domaine.morningstarts_area == 12 %} selected {% endif %}>12</option>
												<option value="13" {% if domaine.morningstarts_area == 13 %} selected {% endif %}>13</option>
												<option value="14" {% if domaine.morningstarts_area == 14 %} selected {% endif %}>14</option>
												<option value="15" {% if domaine.morningstarts_area == 15 %} selected {% endif %}>15</option>
												<option value="16" {% if domaine.morningstarts_area == 16 %} selected {% endif %}>16</option>
												<option value="17" {% if domaine.morningstarts_area == 17 %} selected {% endif %}>17</option>
												<option value="18" {% if domaine.morningstarts_area == 18 %} selected {% endif %}>18</option>
												<option value="19" {% if domaine.morningstarts_area == 19 %} selected {% endif %}>19</option>
												<option value="20" {% if domaine.morningstarts_area == 20 %} selected {% endif %}>20</option>
												<option value="21" {% if domaine.morningstarts_area == 21 %} selected {% endif %}>21</option>
												<option value="22" {% if domaine.morningstarts_area == 22 %} selected {% endif %}>22</option>
												<option value="23" {% if domaine.morningstarts_area == 23 %} selected {% endif %}>23</option>
											</select>
										</div>
									</div>
									<div class="form-group row col-sm-12">
										<label class="col col-sm-10" for="p_eveningends_area">{{ trad.eveningends_area }}</label>
										<div class="col col-sm-2">
											<select class="form-control" name="p_eveningends_area">
												<option value="0" {% if domaine.eveningends_area == 0 %} selected {% endif %}>0</option>
												<option value="1" {% if domaine.eveningends_area == 1 %} selected {% endif %}>1</option>
												<option value="2" {% if domaine.eveningends_area == 2 %} selected {% endif %}>2</option>
												<option value="3" {% if domaine.eveningends_area == 3 %} selected {% endif %}>3</option>
												<option value="4" {% if domaine.eveningends_area == 4 %} selected {% endif %}>4</option>
												<option value="5" {% if domaine.eveningends_area == 5 %} selected {% endif %}>5</option>
												<option value="6" {% if domaine.eveningends_area == 6 %} selected {% endif %}>6</option>
												<option value="7" {% if domaine.eveningends_area == 7 %} selected {% endif %}>7</option>
												<option value="8" {% if domaine.eveningends_area == 8 %} selected {% endif %}>8</option>
												<option value="9" {% if domaine.eveningends_area == 9 %} selected {% endif %}>9</option>
												<option value="10" {% if domaine.eveningends_area == 10 %} selected {% endif %}>10</option>
												<option value="11" {% if domaine.eveningends_area == 11 %} selected {% endif %}>11</option>
												<option value="12" {% if domaine.eveningends_area == 12 %} selected {% endif %}>12</option>
												<option value="13" {% if domaine.eveningends_area == 13 %} selected {% endif %}>13</option>
												<option value="14" {% if domaine.eveningends_area == 14 %} selected {% endif %}>14</option>
												<option value="15" {% if domaine.eveningends_area == 15 %} selected {% endif %}>15</option>
												<option value="16" {% if domaine.eveningends_area == 16 %} selected {% endif %}>16</option>
												<option value="17" {% if domaine.eveningends_area == 17 %} selected {% endif %}>17</option>
												<option value="18" {% if domaine.eveningends_area == 18 %} selected {% endif %}>18</option>
												<option value="19" {% if domaine.eveningends_area == 19 %} selected {% endif %}>19</option>
												<option value="20" {% if domaine.eveningends_area == 20 %} selected {% endif %}>20</option>
												<option value="21" {% if domaine.eveningends_area == 21 %} selected {% endif %}>21</option>
												<option value="22" {% if domaine.eveningends_area == 22 %} selected {% endif %}>22</option>
												<option value="23" {% if domaine.eveningends_area == 23 %} selected {% endif %}>23</option>
											</select>
										</div>
									</div>
									{{ form.input('p_eveningends_minutes_area', trad.eveningends_minutes_area, domaine.eveningends_minutes_area, {classGroup: 'col-sm-12', classLabel: 'col-sm-10', classDivInput: 'col-sm-2 control-label', type: 'number', min: 0, max: 59}) }}
									{{ form.input('p_resolution_area', trad.resolution_area, domaine.resolution_area, {classGroup: 'col-sm-12', classLabel: 'col-sm-10', classDivInput: 'col-sm-2 control-label', type: 'number', min:1}) }}
									{{ form.input('p_duree_par_defaut_reservation_area', trad.duree_par_defaut_reservation_area, domaine.duree_par_defaut_reservation_area, {classGroup: 'col-sm-12', classLabel: 'col-sm-10', classDivInput: 'col-sm-2 control-label', type: 'number', min: 1}) }}
									<div class="form-group row col-sm-12">
										<label class="col col-sm-8" for="p_twentyfourhour_format_area">{{ trad.twentyfourhour_format_area }}</label>
										<div class="col col-sm-4">
											<input type="radio" name="p_twentyfourhour_format_area" value="0" id="label_2a" {% if domaine.twentyfourhour_format_area == '0' %} checked {% endif %} /> <label for="label_2a">{{ trad.twentyfourhour_format_12 }}</label><br>
											<input type="radio" name="p_twentyfourhour_format_area" value="1" id="label_2b" {% if domaine.twentyfourhour_format_area == '1' %} checked {% endif %} /> <label for="label_2b">{{ trad.twentyfourhour_format_24 }}</label><br>
										</div>
									</div>
								</div>
								
								<!-- CAS 2 Basé sur les intitulés -->
								<div {% if domaine.enable_periods == 'n' %} style="display:none;" {% endif %} id="intitule1">
									<div class="form-group row col-sm-12">
										<label class="col col-sm-6" for="p_number_periodes">{{ trad.nombre_de_creneaux }}</label>
										<div class="col col-sm-6">
											<input class="form-control" type="number" id="p_number_periodes" name="p_number_periodes" onkeypress="if (event.keyCode==13) return aff_creneaux()" value="{{ d.numberPeriodes }}">
											<a href="#Per" onclick="javascript:return(aff_creneaux())">{{ trad.goto }}</a>
										</div>
									</div>
									{{ d.nomCrenaux |raw }}
								</div>
							</blockquote>

						</div><!-- /.card-body -->
					</div>
				</div>

			</div>

			<!-- Bloc fonctionnalités -->
			<div class="col col-xl-6 col-lg-12 col-md-12 col-sm-12 col-xs-12">
				<div class="col col-md-12">
					<div class="card">
						<div class="card-header">
							<h3 class="card-title"><i class="fas fa-cog"></i> Fonctionnalités</h3>
						</div>
						<div class="card-body">
							<section id="remplissagedescriptionbreve">
								<h5>{{ trad.remplissage_description_breve_msg }}</h5>
								<input type="radio" name="p_description_breve" value="0" id="label_8a" {% if domaine.description_breve == 0 %} checked {% endif %} /> <label for="label_8a">{{ trad.remplissage_description_breve0 }}</label><br>
								<input type="radio" name="p_description_breve" value="1" id="label_8b" {% if domaine.description_breve == 1 %} checked {% endif %} /> <label for="label_8b">{{ trad.remplissage_description_breve1 }}</label><br>
								<input type="radio" name="p_description_breve" value="2" id="label_8c" {% if domaine.description_breve == 2 %} checked {% endif %} /> <label for="label_8c">{{ trad.remplissage_description_breve2 }}</label><br>
							</section>

							<hr>

							<section id="remplissagedescripcomplete">
								<h5>{{ trad.remplissage_description_complete_msg }}</h5>
								<input type="radio" name="p_description_complete" value="2" id="label_9c" {% if domaine.description_complete == 2 %} checked {% endif %} /> <label for="label_9c">{{ trad.remplissage_description_complete2 }}</label><br>
								<input type="radio" name="p_description_complete" value="0" id="label_9a" {% if domaine.description_complete == 0 %} checked {% endif %} /> <label for="label_9a">{{ trad.remplissage_description_complete0 }}</label><br>
								<input type="radio" name="p_description_complete" value="1" id="label_9b" {% if domaine.description_complete == 1 %} checked {% endif %} /> <label for="label_9b">{{ trad.remplissage_description_complete1 }}</label><br>
							</section>

							<hr>

							<h5>{{ form.switch('p_access_file', trad.ajout_fichier_joint, domaine.access_file, {classGroup: 'col-12', classLabel: 'col-10', classDivInput: 'col-2'}) }}</h5>

							<div id="aff_dyn_fichier_joint">
								<small>{{ trad.ajout_fichier_joint_explain|raw }}</small>

								<div class="form-group row col-sm-12">
									<label class="col col-sm-4" for="p_user_right">Droit pour consulter les fichiers</label>

									<div class="col col-sm-8">
										<select class="form-control" name="p_user_right">
											<option value="1" {% if domaine.user_right == 1 %} selected {% endif %}>{{ trad.visu_fiche_description1 }}</option>
											<option value="2" {% if domaine.user_right == 2 %} selected {% endif %}>{{ trad.visu_fiche_description2 }}</option>
											<option value="3" {% if domaine.user_right == 3 %} selected {% endif %}>{{ trad.visu_fiche_description3 }}</option>
											<option value="4" {% if domaine.user_right == 4 %} selected {% endif %}>{{ trad.visu_fiche_description4 }}</option>
											<option value="5" {% if domaine.user_right == 5 %} selected {% endif %}>{{ trad.visu_fiche_description5 }}</option>
											<option value="6" {% if domaine.user_right == 6 %} selected {% endif %}>{{ trad.visu_fiche_description6 }}</option>
										</select>
									</div>
								</div>

								<div class="form-group row col-sm-12">
									<label class="col col-sm-4" for="p_upload_file">Droit pour téléverser les fichiers</label>

									<div class="col col-sm-8">
										<select class="form-control" name="p_upload_file">
											<option value="1" {% if domaine.upload_file == 1 %} selected {% endif %}>{{ trad.visu_fiche_description1 }}</option>
											<option value="2" {% if domaine.upload_file == 2 %} selected {% endif %}>{{ trad.visu_fiche_description2 }}</option>
											<option value="3" {% if domaine.upload_file == 3 %} selected {% endif %}>{{ trad.visu_fiche_description3 }}</option>
											<option value="4" {% if domaine.upload_file == 4 %} selected {% endif %}>{{ trad.visu_fiche_description4 }}</option>
											<option value="5" {% if domaine.upload_file == 5 %} selected {% endif %}>{{ trad.visu_fiche_description5 }}</option>
											<option value="6" {% if domaine.upload_file == 6 %} selected {% endif %}>{{ trad.visu_fiche_description6 }}</option>
										</select>
									</div>
								</div>
