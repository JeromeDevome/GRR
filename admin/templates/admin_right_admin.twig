{% extends 'layout.twig' %}

{% block css %}
	<link rel="stylesheet" href="../jslib/bootstrap4-duallistbox/bootstrap-duallistbox.min.css">
	<style>
		.bootstrap-duallistbox-container select {
			height: 500px !important;
		}
	</style>
{% endblock %}

{% import 'messagesysteme.twig' as msgSyst %}

{% block content %}
	<div class="row">
		<div class="col col-md-12">

			{% if trad.dMessage %}
				{{ msgSyst.messageInfo(trad.admin_email_manager, trad.dMessage) }}
			{% endif %}

			<div class="box">
				<div class="box-body no-padding">
					<p>{{ trad.admin_right_admin_explain }}</p>

					<hr>

					<form id="area" action="?p=admin_right_admin" method="post">

						<div class="form-group">
							<label class="col col-sm-3" for="f_area">{{ trad.areas }}</label>
							<div class="col col-lg-6">
								<select id="f_area" name="area" class="form-control" onchange="area_go()">
									<option value="-1">{{ trad.select }}</option>
									{% for domaine in domaines %}
										<option value="{{ domaine.id }}" {% if domaine.id == trad.dIdDomaine %} selected {% endif %}>{{ domaine.nom }}</option>
									{% endfor %}
								</select>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>

	<hr>

	{% if d.idDomaine > 0 %}

		<div class="row">
			<!-- Utilisateurs -->
			<div class="col col-sm-12 col-lg-6">
				<form name="utilisateurs" method="post">
					<input type="hidden" name="p_action" value="1" />
					<input type="hidden" name="p_id_site" value="{{ d.idSite }}" />
					<div class="card">
						<div class="card-header">
							<h3 class="card-title"><i class="fas fa-user"></i> {{ trad.admin_user }}</h3>
						</div>
						<div class="card-body no-padding">
							<div class="form-group">
								<select name="p_utilisateurs[]" id="p_utilisateurs" class="duallistbox" multiple="multiple">
									{% for user in utilisateursajoutable %}
										<option value="{{ user.login }}">{{ user.nom }} {{ user.prenom }}</option>
									{% endfor %}
									{% for useradmin in utilisateursadmin %}
										<option value="{{ useradmin.login }}" {% if useradmin.groupeid > 0 %}disabled{% endif %} selected>{{useradmin.idgroupes}}{{ useradmin.nom }} {{ useradmin.prenom }}{% if useradmin.groupeid > 0 %} ({{useradmin.groupenom}}){% endif %}</option>
									{% endfor %}
								</select>
							</div>
						</div>
						<div class="card-footer">
							<center><button type="submit" name="p_submit" value="1" class="btn btn-primary btn-md" /><i class="fas fa-save"></i> {{ trad.save }}</button></center>
						</div>
					</div>
				</form>
			</div>
		</div>
	{% endif %}

{% endblock %}

{% block javascript %}
	<script src="../jslib/bootstrap4-duallistbox/jquery.bootstrap-duallistbox.min.js"></script>
	<script>
		function area_go()
		{
			box = document.getElementById("area").area;
			destination = box.options[box.selectedIndex].value;
			if (destination) location.href = "?p=admin_right_admin&p_id_area="+destination;
		}

		$('#p_utilisateurs').bootstrapDualListbox({
			nonSelectedListLabel: 'Utilisateurs disponibles',
			selectedListLabel: 'Utilisateurs sélectionnés'
		});

		$('.duallistbox').bootstrapDualListbox()
	</script>
{% endblock %}