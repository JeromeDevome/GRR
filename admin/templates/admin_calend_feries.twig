{% extends 'layout.twig' %}

{% import 'messagesysteme.twig' as msgSyst %}
{% import 'champs.twig' as form %}

{% block css %}{% endblock %}

{% block content %}
	<div class="row">
		<div class="col col-md-12">

		{% if settings.show_feries != 1 %}
			<p>Il faut activer l'affichage des jours fériés pour continuer...</p>
			<p><a href="?p=admin_page_reservation" >Cliquer ici pour activer l'affichage des jours fériés</a>
		{% else %}
			<div class="card">
				<div class="card-header">
					<p class="text-muted mb-3">{{ trad.vacances_feries_description2 }}</p>

					<div class="form-group row">
						<form action="?p=admin_calend_feries" method="POST" id="annee">
							<input type="hidden" name="p" value="admin_calend_feries" />
							{{d.liste_annees |raw }}
							<input class="btn-sm btn-primary" type="submit" name="{{ trad.OK }}" value="{{ trad.OK }}" />&nbsp;
						</form>

						<a href="?p=admin_calend_feries" class="btn btn-sm btn-info" onclick="{{ d.cocheFeries }} return false;">{{ trad.vacances_feries_FR }}</a>&nbsp;
						<a href="?p=admin_calend_feries" class="btn btn-sm btn-info" onclick="setCheckboxesGrr(document.getElementById('formulaireF'), false, 'all'); return false;">{{ trad.uncheck_all_ }}</a>&nbsp; 
					</div>
				</div>
				<div class="card-body p-0">
					<form action="?p=admin_calend_feries" method="post" id="formulaireF">
						<input type="hidden" name="p" value="admin_calend_feries" />
						<input type="hidden" name="p_submitCalend" value="1" />
						<input type="hidden" name="From_year" value="{{ d.From_year }}" />
						<div class="row">
							{{ d.calendrier |raw }}
						</div>
						<!-- Enregistrer -->
						<button type="submit" name="ok" class="btn btn-primary position-fixed elevation-4" style="bottom:70px; right:20px; z-index:99;">
							<i class="fas fa-save"></i> {{ trad.save }}
						</button>
					</form>
				</div>
			</div>
		{% endif %}
		</div>
	</div>

{% endblock %}

{% block javascript %}
<script>
	$(function () {
		{%if d.enregistrement == 1 %}
			toastr.success("{{trad.message_records}}")
		{% elseif d.enregistrement == 2 %}
			toastr.warning("{{d.enregistrement|raw}}")
		{% elseif d.enregistrement == 3 %}
			toastr.warning("{{d.enregistrement|raw}}")
		{% endif %}
	});

	function setCheckboxesGrrName(elts, do_check, day)
	{
		for (i = 0; i < elts.length; i++)
		{
			type = elts.type;
			if (type="checkbox")
			{
				if (elts[i].name== day)
				{
					elts[i].checked = do_check;
				}
			}
		}
		return true;
	}

	function setCheckboxesGrr(elts, do_check, day)
	{
		for (i = 0; i < elts.length; i++)
		{
			type = elts.type;
			if (type="checkbox")
			{
				if ((elts[i].value== day) || (day=='all'))
				{
					elts[i].checked = do_check;
				}
			}
		}
		return true;
	}
</script>
{% endblock %}