{% extends 'layout.twig' %}

{% block css %}
	<link rel="stylesheet" href="../jslib/bootstrap4-duallistbox/bootstrap-duallistbox.min.css">
	<style>
		.bootstrap-duallistbox-container select {
			height: 500px !important;
		}
	</style>
{% endblock %}

{% import 'messagesysteme.twig' as msgSyst %}


{% block content %}
	<div class="row">
        <div class="col col-xs-12">
            <div class="box">
				<div class="box-body no-padding">
                    <!-- Première étape : choisir parmi les ressources restreintes -->
					<div class="form-group">
						<label class="col col-sm-3" for="room">{{ trad.rooms }}{{ trad.deux_points }}</label>
						<div class="col col-sm-6">
							<select id="room" name="room" class="form-control" onchange="room_go()">
								<option value="?p=admin_book_room&amp;p_id_room=-1">{{ trad.select }}</option>
								{% for ressource in ressources %}
									<option value="?p=admin_book_room&amp;p_id_room={{ ressource.0 }}" {% if d.id_room == ressource.0 %}selected{% endif %}>{{ ressource.1 }}</option>
									{% endfor %}
							</select>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
					
    <hr>

	<!-- Deuxième étape : la ressource étant choisie, afficher les utilisateurs autorisés à réserver et le formulaire de mise à jour de la liste -->
    {% if d.id_room != -1 %}

		<div class="row">
			<!-- Utilisateurs -->
			<div class="col col-sm-12 col-lg-6">
				<form name="utilisateurs" method="post">
					<input type="hidden" name="p_action" value="1" />
					<input type="hidden" name="p_id_site" value="{{ d.idSite }}" />
					<div class="card">
						<div class="card-header">
							<h3 class="card-title"><i class="fas fa-user"></i> {{ trad.admin_user }}</h3>
						</div>
						<div class="card-body no-padding">
							<div class="form-group">
								<select name="p_utilisateurs[]" id="p_utilisateurs" class="duallistbox" multiple="multiple">
									{% for user in utilisateursajoutable %}
										<option value="{{ user.login }}">{{ user.nom }} {{ user.prenom }}</option>
									{% endfor %}
									{% for useradmin in userAcces %}
										<option value="{{ useradmin.login }}" {% if useradmin.groupeid > 0 %}disabled{% endif %} selected>{{useradmin.idgroupes}}{{ useradmin.nom }} {{ useradmin.prenom }}{% if useradmin.groupeid > 0 %} ({{useradmin.groupenom}}){% endif %}</option>
									{% endfor %}
								</select>
							</div>
						</div>
						<div class="card-footer">
							<center><button type="submit" name="p_submit" value="1" class="btn btn-primary btn-md" /><i class="fas fa-save"></i> {{ trad.save }}</button></center>
						</div>
					</div>
				</form>
			</div>

			<!-- Groupes -->
			<div class="col col-sm-12 col-lg-6">
				<form name="groupes" method="post">
					<input type="hidden" name="p_action" value="2" />
					<input type="hidden" name="p_id_site" value="{{ d.idSite }}" />
					<div class="card">
						<div class="card-header">
							<h3 class="card-title"><i class="fas fa-user-group"></i> {{ trad.groupes }}</h3>
						</div>
						<div class="card-body no-padding">
							<div class="form-group">
								<select name="p_groupes[]" id="p_groupes" class="duallistbox" multiple="multiple">
									{% for groupe in groupesajoutable %}
										<option value="{{ groupe.idgroupe }}">{{ groupe.nom }}</option>
									{% endfor %}
									{% for groupeadmin in groupesexep %}
										<option value="{{ groupeadmin.idgroupe }}" selected>{{ groupeadmin.nom }}</option>
									{% endfor %}
								</select>
							</div>
						</div>
						<div class="card-footer">
							<center><button type="submit" name="p_submit" value="1" class="btn btn-primary btn-md" /><i class="fas fa-save"></i> {{ trad.save }}</button></center>
						</div>
					</div>
				</form>
			</div>
		</div>
	{% endif %}


{% endblock %}

{% block javascript %}
<script src="../jslib/bootstrap4-duallistbox/jquery.bootstrap-duallistbox.min.js"></script>
	<script>
		$(function () {
			{% if d.enregistrement == 1 %}
				toastr.success("{{d.msgToast}}")
			{% elseif d.enregistrement == 2 %}
				toastr.warning("{{d.msgToast}}")
			{% elseif d.enregistrement == 3 %}
				toastr.error("{{d.msgToast}}")
			{% endif %}
		});

		function room_go()
		{
			box = document.getElementById('room');
			destination = box.options[box.selectedIndex].value;
			if (destination) location.href = destination;
		}

		$('#p_utilisateurs').bootstrapDualListbox({
			nonSelectedListLabel: 'Utilisateurs disponibles',
			selectedListLabel: 'Utilisateurs sélectionnés'
		});

		$('#p_groupes').bootstrapDualListbox({
			nonSelectedListLabel: 'Groupes disponibles',
			selectedListLabel: 'Groupes sélectionnés'
		});

		$('.duallistbox').bootstrapDualListbox()
	</script>
{% endblock %}