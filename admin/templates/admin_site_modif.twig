{% extends 'layout.twig' %}

{% import 'messagesysteme.twig' as msgSyst %}
{% import 'champs.twig' as form %}

{% block content %}
	<div class="row">
		<div class="col col-md-12">

			{% if d.mesgSysteme %}
				{{ msgSyst.messageAlerte('', d.mesgSysteme) }}
			{% endif %}

			<div class="card">
				<div class="card-header">
					<p>{{ trad.required }}</p>
				</div>
				<form action="?p=admin_site&amp;p_action={{ d.action }}" method="post">
					<div class="card-body no-padding">
						<input type="hidden" name="p_idsite" value="{{ d.idsite }}" />
						
						{{ form.input('p_sitecode', trad.site_code, site.code, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label', classInput:'text-uppercase', require:1, maxlength:10}) }}
						<div class="form-group row">
							<label class="col col-sm-4" for="p_access">{{ trad.site_access }}</label>
							<div class="col col-sm-8">
								<input type="checkbox" name="p_access" value="r" {% if site.access == 'r' %} checked {% endif %}>
							</div>
						</div>
						{{ form.input('p_sitename', trad.site_name, site.nom, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label', require:1}) }}
						{{ form.input('p_adresse_ligne1', trad.site_adresse_ligne1, site.adresse_ligne1, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label'}) }}
						{{ form.input('p_adresse_ligne2', trad.site_adresse_ligne2, site.adresse_ligne2, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label'}) }}
						{{ form.input('p_adresse_ligne3', trad.site_adresse_ligne3, site.adresse_ligne3, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label'}) }}
						{{ form.input('p_cp', trad.site_cp, site.cp, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label', maxlength:5}) }}
						{{ form.input('p_ville', trad.site_ville, site.ville, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label'}) }}
						{{ form.input('p_pays', trad.site_pays, site.pays, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label'}) }}
						{{ form.input('p_tel', trad.site_tel, site.tel, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label'}) }}
						{{ form.input('p_fax', trad.site_fax, site.fax, {classLabel: 'col-sm-4', classDivInput: 'col-sm-8 control-label'}) }}
					</div>

					<div class="card-footer">
						<a href="?p=admin_site" name="back" class="btn btn-default btn-md" /><i class="fas fa-circle-left"></i> {{ trad.back }}</a>
						<button type="submit" name="p_submit" value="1" class="btn btn-success btn-md float-right" /><i class="fas fa-save"></i> {{ trad.save }}</button>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascript %}
{% endblock %}